{
  "name": "wpm",
  "version": "0.1.0",
  "description": "The work-package-manager (wpm) installer-builder CLI: authors and packages agentic bundle-projects (see docs/00-14).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wpm": "./dist/cli.js",
    "installer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "25.9.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
