# {{project-name}} — project release identity + the bundles this installer ships.
# Per-bundle metadata (version, summary, requires) lives in each bundles/<id>/bundle.yml.
project:
  name: {{project-name}}
  version: 0.1.0 # the project's release version (distinct from per-bundle versions)

# The agents this installer supports; each becomes a scope-alias the install creates.
# Add with `wpm project targets add <agent>` (e.g. claude-code).
targets: []

# The flat list of enabled bundle IDs. Add with `wpm bundle new <id>`.
bundles: []
